# Plantilla del .env de PRODUCCIÓN.
# NO se sube a Git: se guarda en Jenkins como credencial "Secret file" (ID: laravel-env-prod).
# Evita usar el símbolo $ en las contraseñas.

APP_NAME=Laravel
APP_ENV=production
APP_KEY=base64:PEGA_AQUI_LA_SALIDA_DE_php_artisan_key_generate_--show
APP_DEBUG=false
APP_URL=http://localhost:8081

# stderr = los logs de Laravel se ven con "docker logs laravel-app"
LOG_CHANNEL=stderr
LOG_LEVEL=info

DB_CONNECTION=mysql
DB_HOST=db
DB_PORT=3306
DB_DATABASE=laravel
DB_USERNAME=laravel
DB_PASSWORD=CambiaEstaClave123
DB_ROOT_PASSWORD=CambiaEstaClaveRoot123

CACHE_DRIVER=file
SESSION_DRIVER=file
QUEUE_CONNECTION=sync
FILESYSTEM_DISK=local
